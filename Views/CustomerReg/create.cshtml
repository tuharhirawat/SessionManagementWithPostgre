@model ZoomColorLab.Models.StaffRegViewModel

@{
    ViewData["Title"] = "Staff Registration";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    .registration-form {
        background-color: #f2f2f2;
        padding: 30px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .form-label {
        font-weight: 600;
        font-size: 14px;
    }

    .form-control, .form-select {
        font-size: 14px;
        height: 32px;
    }

    .form-section {
        max-width: 1000px;
        margin: auto;
    }

    .form-heading {
        text-align: center;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 20px;
    }

    .form-buttons {
        text-align: center;
        margin-top: 50px;
    }

    .btn-icon {
        width: 90px;
        margin: 15px;
    }

    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px 30px;
    }
</style>

<div class="container mt-4">
    <div class="form-section">
        <div class="registration-form shadow">
            <div class="form-heading">Staff Registration</div>

            <form asp-action="Create" method="post">
                <div class="two-col-grid">
                    <div>
                        <label class="form-label">First Name</label>
                        <input type="text" name="FirstName" class="form-control" required />
                    </div>
                    <div>
                        <label class="form-label">Last Name</label>
                        <input type="text" name="LastName" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label">Address 1</label>
                        <input type="text" name="Address1" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label">Address 2</label>
                        <input type="text" name="Address2" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label">DOB</label>
                        <input type="date" name="DateOfBirth" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label">DOJ</label>
                        <input type="date" name="DateOfJoining" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label">Phone 1</label>
                        <input type="text" name="Phone1" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label">Phone 2</label>
                        <input type="text" name="Phone2" class="form-control" />
                    </div>

                    <div>
                        <label class="form-label">WhatsApp</label>
                        <input type="text" name="Whatsapp" class="form-control" />
                    </div>

                    <div>
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" required />
                    </div>

                    <div>
                        <label class="form-label">Phone Type</label>
                        <select name="PhoneTypeId" class="form-select" required>
                            <option value="">-- Select Phone Type --</option>
                            @foreach (var type in Model.PhoneTypes)
                            {
                                <option value="@type.PhoneTypeId">@type.PhoneTypeName</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Branch</label>
                        <select id="BranchId" name="BranchId" class="form-select" required>
                            <option value="">-- Select Branch --</option>
                            @foreach (var branch in Model.Branches)
                            {
                                <option value="@branch.BranchId">@branch.BranchName</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Department</label>
                        <select name="DeptId" class="form-select" required>
                            <option value="">-- Select Department --</option>
                            @foreach (var department in Model.Departments)
                            {
                                <option value="@department.DeptId">@department.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Designation</label>
                        <select id="DesignationId" name="DesignationId" class="form-select" required>
                            <option value="">-- Select Designation --</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Category</label>
                        <select id="CategoryId" name="CategoryId" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var category in Model.CustomerCategories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Remarks</label>
                        <textarea name="Remarks" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="form-buttons">
                    <button type="submit" class="btn btn-success btn-icon">Register</button>
                    <button type="reset" class="btn btn-secondary btn-icon">Clear</button>
                    <a href="/StaffReg/Index" class="btn btn-danger btn-icon">Exit</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('BranchId')?.addEventListener('change', function () {
            var branchId = this.value;
            if (!branchId) {
                console.error("Branch ID is missing");
                return;
            }

            // Fetch designations based on department
            fetch('/StaffReg/GetDesignationsByDepartment?deptId=' + branchId)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    var designationSelect = document.getElementById('DesignationId');
                    designationSelect.innerHTML = '<option value="">-- Select Designation --</option>';

                    if (data.length === 0) {
                        console.warn("No designations found for this department");
                    }

                    data.forEach(designation => {
                        var option = document.createElement('option');
                        option.value = designation.id;
                        option.text = designation.name;
                        designationSelect.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('There was an error with the fetch operation:', error);
                });

            // Fetch categories based on branch
            fetch('/StaffReg/GetCategoriesByBranch?branchId=' + branchId)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    var categorySelect = document.getElementById('CategoryId');
                    categorySelect.innerHTML = '<option value="">-- Select Category --</option>';

                    if (data.length === 0) {
                        console.warn("No categories found for this branch");
                    }

                    data.forEach(category => {
                        var option = document.createElement('option');
                        option.value = category.id;
                        option.text = category.name;
                        categorySelect.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error('There was an error with the fetch operation for categories:', error);
                });
        });
    </script>
}