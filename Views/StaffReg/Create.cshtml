@model ZoomColorLab.Models.StaffRegViewModel

@{
    ViewData["Title"] = "Staff Registration";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    .registration-form {
        background-color: #f2f2f2;
        padding: 30px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .form-label {
        font-weight: 600;
        font-size: 14px;
    }

    .form-control, .form-select {
        font-size: 14px;
        height: 32px;
    }

    .form-section {
        max-width: 1000px;
        margin: auto;
    }

    .form-heading {
        text-align: center;
        font-weight: bold;
        font-size: 18px;
        margin-bottom: 20px;
    }

    .form-buttons {
        text-align: center;
        margin-top: 50px;
    }

    .btn-icon {
        width: 90px;
        margin: 15px;
    }

    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px 30px;
    }

    .validation-error {
        font-size: 13px;
        margin-top: 4px;
    }
</style>

<div class="container mt-4">
    <div class="form-section">
        <div class="registration-form shadow">

            @* ✅ Success message *@
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="form-heading">Staff Registration</div>

            <form id="staffForm" asp-action="Create" method="post" novalidate>
                <div class="two-col-grid">
                    <div>
                        <label class="form-label">First Name</label>
                        <input type="text" name="FirstName" class="form-control" required />
                        <div class="text-danger validation-error" style="display:none;">First Name is required</div>
                    </div>

                    <div>
                        <label class="form-label">Last Name</label>
                        <input type="text" name="LastName" class="form-control" required />
                        <div class="text-danger validation-error" style="display:none;">Last Name is required</div>
                    </div>

                    <div>
                        <label class="form-label">Address 1</label>
                        <input type="text" name="Address1" class="form-control" required />
                        <div class="text-danger validation-error" style="display:none;">Address 1 is required</div>
                    </div>

                    <div>
                        <label class="form-label">Address 2</label>
                        <input type="text" name="Address2" class="form-control" />
                        <div class="text-danger validation-error" style="display:none;">Address 2 is required</div>

                    </div>

                    <div>
                        <label class="form-label">DOB</label>
                        <input type="text" name="DOB" class="form-control" placeholder="yyyy-MM-dd" required pattern="^\d{4}-\d{2}-\d{2}$" />
                        <div class="text-danger validation-error" style="display:none;">DOB is required and must be in yyyy-MM-dd format</div>
                    </div>

                    <div>
                        <label class="form-label">DOJ</label>
                        <input type="text" name="DOJ" class="form-control" placeholder="yyyy-MM-dd" required pattern="^\d{4}-\d{2}-\d{2}$" />
                        <div class="text-danger validation-error" style="display:none;">DOJ is required and must be in yyyy-MM-dd format</div>
                    </div>

                    <div>
                        <label class="form-label">Phone 1</label>
                        <input type="text" name="Phone1" class="form-control" required pattern="^\+?[0-9]{7,15}$" />
                        <div class="text-danger validation-error" style="display:none;">Phone 1 is required and must be a valid number</div>
                    </div>

                    <div>
                        <label class="form-label">Phone 2</label>
                        <input type="text" name="Phone2" class="form-control" pattern="^\+?[0-9]{7,15}$" />
                        <div class="text-danger validation-error" style="display:none;">Phone 2 must be a valid number</div>
                    </div>

                    <div>
                        <label class="form-label">WhatsApp</label>
                        <input type="text" name="Whatsapp" class="form-control" pattern="^\+?[0-9]{7,15}$" />
                        <div class="text-danger validation-error" style="display:none;">WhatsApp must be a valid number</div>
                    </div>

                    <div>
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" required />
                        <div class="text-danger validation-error" style="display:none;">Valid email is required</div>
                    </div>

                    <div>
                        <label class="form-label">Phone Type</label>
                        <select name="PhoneTypeId" class="form-select" required>
                            <option value="">-- Select Phone Type --</option>
                            @foreach (var type in Model.PhoneTypes)
                            {
                                <option value="@type.PhoneTypeId">@type.PhoneTypeName</option>
                            }
                        </select>
                        <div class="text-danger validation-error" style="display:none;">Phone Type is required</div>
                    </div>

                    <div>
                        <label class="form-label">Branch</label>
                        <select id="BranchId" name="BranchId" class="form-select" required>
                            <option value="">-- Select Branch --</option>
                            @foreach (var branch in Model.Branches)
                            {
                                <option value="@branch.BranchId">@branch.BranchName</option>
                            }
                        </select>
                        <div class="text-danger validation-error" style="display:none;">Branch is required</div>
                    </div>

                    <div>
                        <label class="form-label">Department</label>
                        <select name="DeptId" class="form-select" required>
                            <option value="">-- Select Department --</option>
                            @foreach (var department in Model.Departments)
                            {
                                <option value="@department.DeptId">@department.Name</option>
                            }
                        </select>
                        <div class="text-danger validation-error" style="display:none;">Department is required</div>
                    </div>

                    <div>
                        <label class="form-label">Designation</label>
                        <select id="DesignationId" name="DesignationId" class="form-select" required>
                            <option value="">-- Select Designation --</option>
                        </select>
                        <div class="text-danger validation-error" style="display:none;">Designation is required</div>
                    </div>

                    <div>
                        <label class="form-label">Category</label>
                        <select id="CategoryId" name="CategoryId" class="form-select" required>
                            <option value="">-- Select Category --</option>
                            @foreach (var category in Model.CustomerCategories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                        <div class="text-danger validation-error" style="display:none;">Category is required</div>
                    </div>

                    <div>
                        <label class="form-label">Remarks</label>
                        <textarea name="Remarks" class="form-control" rows="3"></textarea>
                        <div class="text-danger validation-error" style="display:none;">Remarks  is required</div>

                    </div>

                    <div>
                        <label class="form-label">Username</label>
                        <input type="text" name="UserName" class="form-control" required />
                        <div class="text-danger validation-error" style="display:none;">Username is required</div>
                    </div>

                    <div>
                        <label class="form-label">Password</label>
                        <input type="password" name="Password" class="form-control" required />
                        <div class="text-danger validation-error" style="display:none;">Password is required</div>
                    </div>
                </div>

                <div class="form-buttons">
                    <button type="submit" class="btn btn-success btn-icon">Register</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('staffForm').addEventListener('submit', function (e) {
            e.preventDefault();

            let form = this;
            let isValid = true;

            // Hide all previous error messages
            form.querySelectorAll('.validation-error').forEach(div => div.style.display = 'none');

            // Validate each input/select/textarea
            form.querySelectorAll('input, select, textarea').forEach(input => {
                if (input.hasAttribute('required')) {
                    if (!input.value.trim()) {
                        showError(input, true);
                        isValid = false;
                        return;
                    }
                }

                if (input.hasAttribute('pattern') && input.value.trim()) {
                    let pattern = new RegExp(input.getAttribute('pattern'));
                    if (!pattern.test(input.value.trim())) {
                        showError(input, true);
                        isValid = false;
                        return;
                    }
                }

                showError(input, false);
            });

            if (isValid) {
                form.submit();
            }

            function showError(input, show) {
                let errorDiv = input.parentElement.querySelector('.validation-error');
                if (errorDiv) {
                    errorDiv.style.display = show ? 'block' : 'none';
                }
            }
        });

        // Existing dynamic designation and category loading code
        document.getElementById('BranchId')?.addEventListener('change', function () {
            var branchId = this.value;
            if (!branchId) return;

            fetch('/StaffReg/GetDesignationsByDepartment?deptId=' + branchId)
                .then(response => response.json())
                .then(data => {
                    var designationSelect = document.getElementById('DesignationId');
                    designationSelect.innerHTML = '<option value="">-- Select Designation --</option>';
                    data.forEach(designation => {
                        var option = document.createElement('option');
                        option.value = designation.id;
                        option.text = designation.name;
                        designationSelect.appendChild(option);
                    });
                });

            fetch('/StaffReg/GetCategoriesByBranch?branchId=' + branchId)
                .then(response => response.json())
                .then(data => {
                    var categorySelect = document.getElementById('CategoryId');
                    categorySelect.innerHTML = '<option value="">-- Select Category --</option>';
                    data.forEach(category => {
                        var option = document.createElement('option');
                        option.value = category.id;
                        option.text = category.name;
                        categorySelect.appendChild(option);
                    });
                });
        });
    </script>
}
